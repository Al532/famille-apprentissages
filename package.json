{
  "name": "famille-apprentissages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --mode enfants",
    "dev:parents": "vite --config apps/web/vite.config.ts --mode parents --port 5174",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts tests/history.test.ts tests/pwa.test.ts tests/concepts.test.ts tests/coherence.test.ts tests/conjugaison.test.ts",
    "test:rules": "firebase emulators:exec --project demo-famille --only firestore \"node --import tsx --test --test-concurrency=1 tests/firestore.rules.test.ts tests/sync.test.ts\"",
    "build": "npm run build:enfants && npm run build:parents",
    "build:enfants": "vite build --config apps/web/vite.config.ts --mode enfants",
    "build:parents": "vite build --config apps/web/vite.config.ts --mode parents",
    "catalog:validate": "node --import tsx scripts/catalog.ts validate",
    "catalog:import": "node --import tsx scripts/catalog.ts import",
    "provision": "node --import tsx scripts/provision.ts",
    "export:family": "node --import tsx scripts/export-family.ts",
    "emulators": "firebase emulators:start --project demo-famille --only auth,firestore",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@famille/core": "*",
    "firebase": "13.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "14.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "firebase-admin": "14.5.0"
  }
}
